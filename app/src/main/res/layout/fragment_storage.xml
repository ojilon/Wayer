<?xml version="1.0" encoding="utf-8"?>

<!--
  Storage screen foundation.
  - Summary + progress
  - Category visualisation (weighted bars – pure XML, no chart library)
  - Large files list (for cleanup)
  - Quick free-space actions
-->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wayer_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Storage"
            android:textColor="@color/wayer_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="Overview and cleanup tools"
            android:textColor="@color/wayer_text_secondary"
            android:textSize="14sp" />

        <!-- Summary card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            app:cardBackgroundColor="@color/wayer_surface"
            app:cardCornerRadius="@dimen/radius_md"
            app:strokeColor="@color/wayer_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/storage_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calculating…"
                    android:textColor="@color/wayer_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/storage_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:max="100"
                    android:progress="0" />

                <TextView
                    android:id="@+id/storage_free"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text=""
                    android:textColor="@color/wayer_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Category breakdown (visual bars) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="By type"
            android:textColor="@color/wayer_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            app:cardBackgroundColor="@color/wayer_surface"
            app:cardCornerRadius="@dimen/radius_md"
            app:strokeColor="@color/wayer_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <!-- Stacked bar (weights set from Java) -->
                <LinearLayout
                    android:id="@+id/category_bar"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:orientation="horizontal"
                    android:background="@color/wayer_surface_variant">

                    <View android:id="@+id/bar_images" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/wayer_cat_images" />
                    <View android:id="@+id/bar_videos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/wayer_cat_videos" />
                    <View android:id="@+id/bar_audio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/wayer_cat_audio" />
                    <View android:id="@+id/bar_docs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/wayer_cat_docs" />
                    <View android:id="@+id/bar_others" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/wayer_cat_others" />
                </LinearLayout>

                <!-- Legend rows -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@color/wayer_cat_images" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Images" android:textColor="@color/wayer_text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/cat_images" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/wayer_text_primary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@color/wayer_cat_videos" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Videos" android:textColor="@color/wayer_text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/cat_videos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/wayer_text_primary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@color/wayer_cat_audio" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Audio" android:textColor="@color/wayer_text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/cat_audio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/wayer_text_primary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@color/wayer_cat_docs" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Documents" android:textColor="@color/wayer_text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/cat_documents" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/wayer_text_primary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@color/wayer_cat_others" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Others" android:textColor="@color/wayer_text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/cat_others" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/wayer_text_primary" android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Large files (cleanup) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="Large files"
            android:textColor="@color/wayer_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="Select items to free space (delete coming next)"
            android:textColor="@color/wayer_text_secondary"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/large_files_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/large_files_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="No large files found yet"
            android:textColor="@color/wayer_text_secondary"
            android:textSize="14sp" />

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="Refresh storage stats" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan_large"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Scan for large files" />

    </LinearLayout>
</ScrollView>
