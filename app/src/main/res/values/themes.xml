<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme.Wayer — updated Oct 2025 for standard Material 3 components.

  What changed:
    * Card style uses elevation (2dp) instead of translucent glass + stroke.
      Stroke only on outlined cards (GlassCard.Outlined), not on default.
      This removes the "everything is a glass button" look.
    * Button corners use radius_sm (8dp) not radius_md — more standard.
    * BottomNavigationView style is now used (NavigationBarView handles 6 items
      natively; we no longer need the HorizontalScrollView+ToggleGroup hack).
    * Added Surface styles for Toolbar and BottomAppBar.
    * Typography: use Material3 typeScale (titleMedium, bodyMedium) via theme;
      legacy textSize 28sp now uses displaySmall for the "Wayer" wordmark.
-->
<resources>

    <style name="Theme.Wayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/wayer_background</item>
        <item name="android:navigationBarColor">@color/wayer_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/wayer_background</item>

        <item name="colorPrimary">@color/wayer_primary</item>
        <item name="colorOnPrimary">@color/wayer_on_primary</item>
        <item name="colorPrimaryContainer">@color/wayer_primary_container</item>
        <item name="colorSecondary">@color/wayer_primary</item>

        <item name="colorSurface">@color/wayer_surface_solid</item>
        <item name="colorOnSurface">@color/wayer_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/wayer_text_secondary</item>
        <item name="colorSurfaceVariant">@color/wayer_surface_variant</item>

        <item name="colorOutline">@color/wayer_outline</item>
        <item name="colorOutlineVariant">@color/wayer_outline_variant</item>
        <item name="colorError">@color/wayer_error</item>

        <item name="android:fontFamily">sans-serif</item>

        <!-- Material 3 bottom bar style — handled by NavigationBarView -->
        <item name="bottomNavigationStyle">@style/Widget.Wayer.BottomNavigation</item>
        <item name="materialCardViewStyle">@style/Widget.Wayer.Card</item>
    </style>

    <style name="Widget.Wayer.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/wayer_surface_solid</item>
        <item name="itemIconTint">@color/wayer_primary</item>
        <item name="itemTextColor">@color/wayer_text_secondary</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Wayer.BottomNavIndicator</item>
        <item name="elevation">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Wayer.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/wayer_primary_container</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>

    <!-- Default card: solid surface, soft elevation, no stroke — clean Material -->
    <style name="Widget.Wayer.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/wayer_surface</item>
        <item name="cardCornerRadius">@dimen/radius_sm</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Outlined card — for secondary surfaces (e.g. cleaner utility grid) -->
    <style name="Widget.Wayer.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/wayer_surface</item>
        <item name="cardCornerRadius">@dimen/radius_sm</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/wayer_outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Glass card — only when blur is enabled (opt-in, not default) -->
    <style name="Widget.Wayer.GlassCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/wayer_glass</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/wayer_outline_glass</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Wayer.GlassCard.Compact">
        <item name="cardCornerRadius">@dimen/radius_sm</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Buttons — standard Material3, no glass -->
    <style name="Widget.Wayer.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Wayer.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="strokeColor">@color/wayer_outline</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Wayer.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Legacy aliases so old XML still compiles -->
    <style name="Widget.Wayer.GlassButton" parent="Widget.Wayer.Button" />
    <style name="Widget.Wayer.GlassButton.Outlined" parent="Widget.Wayer.Button.Outlined" />

</resources>
