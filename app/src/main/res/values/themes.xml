<?xml version="1.0" encoding="utf-8"?>

<!--
  Theme.Wayer + glass Material helpers.
  Cards/panels prefer translucent surfaces and soft outlines (XML-only “glass”).
-->

<resources>

    <style name="Theme.Wayer" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:statusBarColor">@color/wayer_background</item>
        <item name="android:navigationBarColor">@color/wayer_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/wayer_background</item>

        <item name="colorPrimary">@color/wayer_primary</item>
        <item name="colorOnPrimary">@color/wayer_on_primary</item>
        <item name="colorPrimaryContainer">@color/wayer_primary_container</item>
        <item name="colorSecondary">@color/wayer_primary</item>

        <item name="colorSurface">@color/wayer_surface_solid</item>
        <item name="colorOnSurface">@color/wayer_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/wayer_text_secondary</item>
        <item name="colorSurfaceVariant">@color/wayer_surface_variant</item>

        <item name="colorOutline">@color/wayer_outline</item>
        <item name="colorError">@color/wayer_error</item>

        <item name="android:fontFamily">sans-serif</item>

        <item name="bottomNavigationStyle">@style/Widget.Wayer.BottomNavigation</item>
        <item name="materialCardViewStyle">@style/Widget.Wayer.GlassCard</item>
    </style>

    <style name="Widget.Wayer.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/wayer_surface_solid</item>
        <item name="itemIconTint">@color/wayer_primary</item>
        <item name="itemTextColor">@color/wayer_text_secondary</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- Default glass card: translucent fill, soft edge, no heavy shadow -->
    <style name="Widget.Wayer.GlassCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/wayer_surface</item>
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/wayer_outline_glass</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Wayer.GlassCard.Compact">
        <item name="cardCornerRadius">@dimen/radius_sm</item>
        <item name="strokeWidth">0.5dp</item>
    </style>

    <style name="Widget.Wayer.GlassButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Wayer.GlassButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="strokeColor">@color/wayer_outline_glass</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
