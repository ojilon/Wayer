<?xml version="1.0" encoding="utf-8"?>

<!--
  Central design tokens for Wayer (dark theme is default).
  Edit only here (and values-night/) to change the whole app look.
-->

<resources>

    <!-- Core surfaces -->
    <color name="wayer_background">#0B0D11</color>
    <color name="wayer_surface">#15181F</color>
    <color name="wayer_surface_variant">#1E222C</color>
    <color name="wayer_surface_elevated">#252A36</color>

    <!-- Brand -->
    <color name="wayer_primary">#7C9CFF</color>
    <color name="wayer_primary_dark">#5B7BE0</color>
    <color name="wayer_primary_container">#1A2540</color>
    <color name="wayer_on_primary">#FFFFFF</color>

    <!-- Text -->
    <color name="wayer_text_primary">#F0F2F7</color>
    <color name="wayer_text_secondary">#9AA3B5</color>
    <color name="wayer_text_disabled">#5C6575</color>

    <!-- Status -->
    <color name="wayer_success">#3DCF8E</color>
    <color name="wayer_warning">#F0B429</color>
    <color name="wayer_error">#F07178</color>
    <color name="wayer_info">#5CCFE6</color>

    <!-- Borders / dividers -->
    <color name="wayer_outline">#2C3240</color>
    <color name="wayer_outline_variant">#3A4152</color>

    <!-- Category accents (used on Home storage breakdown) -->
    <color name="wayer_cat_images">#FF8A65</color>
    <color name="wayer_cat_videos">#4FC3F7</color>
    <color name="wayer_cat_audio">#BA68C8</color>
    <color name="wayer_cat_docs">#81C784</color>
    <color name="wayer_cat_others">#90A4AE</color>

</resources>
