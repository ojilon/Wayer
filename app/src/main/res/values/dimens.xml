<?xml version="1.0" encoding="utf-8"?>
<!--
  Wayer dimension tokens — updated Oct 2025 for standard Material 3 sizing.

  Philosophy change (see docs/FRONTEND_IMPROVEMENTS.md):
    * Radius tokens reduced — the previous 16dp/24dp everywhere read as chunky
      bubbly buttons. Cards now use radius_sm (8dp); only large hero surfaces
      use radius_md (12dp). List rows use radius_xs (4dp) or no card at all.
    * Spacing stays consistent; touch targets are now 48dp minimum.
-->
<resources>

    <!-- Spacing scale -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>
    <dimen name="spacing_xl">32dp</dimen>

    <!-- Corner radii — reduced from previous 16dp/24dp defaults -->
    <dimen name="radius_xs">4dp</dimen>   <!-- list rows, chips, input boxes -->
    <dimen name="radius_sm">8dp</dimen>   <!-- cards, buttons, sheets -->
    <dimen name="radius_md">12dp</dimen>  <!-- hero cards, dialogs -->
    <dimen name="radius_lg">16dp</dimen>  <!-- bottom sheets, large surfaces -->
    <dimen name="radius_xl">20dp</dimen>  <!-- reserved for future large surfaces -->

    <!-- Component sizing -->
    <dimen name="toolbar_height">56dp</dimen>
    <dimen name="bottom_nav_height">80dp</dimen>
    <dimen name="fab_size">56dp</dimen>
    <dimen name="list_item_height">64dp</dimen>
    <dimen name="divider_thickness">1dp</dimen>

</resources>
