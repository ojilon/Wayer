# Copy this file to keystore.properties in the repo root and fill real values.
# keystore.properties is gitignored — never commit secrets.
#
# Generate a keystore once:
#   keytool -genkey -v -keystore wayer-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias wayer
#
storeFile=wayer-release.jks
storePassword=CHANGE_ME
keyAlias=wayer
keyPassword=CHANGE_ME
