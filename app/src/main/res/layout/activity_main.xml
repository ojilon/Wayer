<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Top current path status display -->
    <TextView
        android:id="@+id/tv_current_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Path: /"
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Terminal Output Container with the NEW custom border -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        android:padding="10dp"
        android:background="@drawable/terminal_border"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tv_terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to Wayer CLI Terminal Engine.\nCommands:\n  ls         - List local files\n  cd (dir)   - Change local directory\n  /ask (file)- Download from PC\n  /send (file)- Upload to PC\n\n"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <!-- Bottom Input Box Container with the NEW input style background -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/input_field_box"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&gt; "
            android:textColor="#00FF60"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingEnd="4dp"/>

        <EditText
            android:id="@+id/et_command_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="enter protocol query..."
            android:textColorHint="#555555"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:inputType="text"
            android:imeOptions="actionDone" />
    </LinearLayout>

</LinearLayout>
