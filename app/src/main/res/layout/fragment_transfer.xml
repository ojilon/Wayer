<?xml version="1.0" encoding="utf-8"?>

<!--
  Transfer screen with right sidebar + in-window tabs (ViewFlipper).
  Glass cards via wayer_surface + outline_glass; theme control in drawer.
-->

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/transfer_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wayer_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_transfer"
                    android:textColor="@color/wayer_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_fragment_transfer_text_24"
                    android:textColor="@color/wayer_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_open_transfer_drawer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_more"
                android:contentDescription="@string/btn_open_transfer_drawer_desc"
                app:tint="@color/wayer_text_primary" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true"
            android:paddingTop="@dimen/spacing_sm">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/transfer_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_guide"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_guide" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_transfer"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_transfer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_search"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_search" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_browse"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_browse" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_network"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_network" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </HorizontalScrollView>

        <ViewFlipper
            android:id="@+id/transfer_view_flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 0 · Guide: how to move files between phone and WayerPC -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/layout_fragment_transfer_text_25"
                        android:textColor="@color/wayer_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/layout_fragment_transfer_text_26"
                        android:textColor="@color/wayer_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_md">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        app:cardBackgroundColor="@color/wayer_surface"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:strokeColor="@color/wayer_outline_glass"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/layout_fragment_transfer_text_27"
                                android:textColor="@color/wayer_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:hint="@string/layout_fragment_transfer_hint_28"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/transfer_filename"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:textColor="@color/wayer_text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <TextView
                                android:id="@+id/save_path_hint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/save_path_hint"
                                android:textColor="@color/wayer_text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/layout_fragment_transfer_text_29"
                                android:textColor="@color/wayer_text_secondary"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_download"
                                    style="@style/Widget.Wayer.GlassButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/btn_download" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_upload"
                                    style="@style/Widget.Wayer.GlassButton.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_sm"
                                    android:layout_weight="1"
                                    android:text="@string/btn_upload" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/layout_fragment_transfer_text_30"
                        android:textColor="@color/wayer_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/session_queue_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/session_queue_status"
                        android:textColor="@color/wayer_text_secondary"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/session_queue_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/session_queue_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/session_queue_empty"
                        android:textColor="@color/wayer_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel_queue"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/btn_cancel_queue"
                        android:visibility="gone" />

                </LinearLayout>
            </ScrollView>

            <!-- 2 - Search: global index search with multi-send -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/layout_fragment_transfer_text_31"
                    android:textColor="@color/wayer_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/search_input_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:textColor="@color/wayer_text_primary"
                    android:textColorHint="@color/wayer_text_secondary"
                    android:background="@drawable/input_field_box"
                    android:padding="@dimen/spacing_sm" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_run_search"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tab_search" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_search_select"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:text="@string/btn_search_select" />

                </LinearLayout>

                <TextView
                    android:id="@+id/search_results_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/search_results_hint"
                    android:textColor="@color/wayer_text_secondary"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_results_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:clipToPadding="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_search_up"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_files_up" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_search_send"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/btn_search_send" />

                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/layout_fragment_transfer_text_32"
                        android:textColor="@color/wayer_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_browse_up"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_files_up" />

                </LinearLayout>

                <TextView
                    android:id="@+id/browse_current_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/browse_current_path"
                    android:textColor="@color/wayer_text_secondary"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="middle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/browse_folder_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:clipToPadding="false" />

                <EditText
                    android:id="@+id/browse_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:hint="@string/browse_filter_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/wayer_text_primary"
                    android:textColorHint="@color/wayer_text_secondary"
                    android:background="@drawable/input_field_box"
                    android:padding="@dimen/spacing_sm" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_sm">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_back_to_transfer"
                        style="@style/Widget.Wayer.GlassButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_back_to_transfer" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_use_this_folder"
                        style="@style/Widget.Wayer.GlassButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:text="@string/btn_select_save_folder" />
                </LinearLayout>
            </LinearLayout>
            <!-- 4 - Network: connection, session, log, history -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_md">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/wayer_surface"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:strokeColor="@color/wayer_outline_glass"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/layout_fragment_transfer_text_33"
                                android:textColor="@color/wayer_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/connection_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/connection_status"
                                android:textColor="@color/wayer_warning"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/connection_details"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/connection_details"
                                android:textColor="@color/wayer_text_secondary"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_md"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_test_connection"
                                    style="@style/Widget.Wayer.GlassButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/btn_test_connection" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_start_listener"
                                    style="@style/Widget.Wayer.GlassButton.Outlined"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_sm"
                                    android:layout_weight="1"
                                    android:text="@string/btn_start_listener" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        app:cardBackgroundColor="@color/wayer_surface"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:strokeColor="@color/wayer_outline_glass"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_md">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/layout_fragment_transfer_text_30"
                                android:textColor="@color/wayer_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/session_stats"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_sm"
                                android:text="@string/session_stats"
                                android:textColor="@color/wayer_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/bandwidth_hint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="@string/bandwidth_hint"
                                android:textColor="@color/wayer_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/layout_fragment_transfer_text_34"
                        android:textColor="@color/wayer_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:cardBackgroundColor="@color/wayer_surface"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:strokeColor="@color/wayer_outline_glass"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/transfer_log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="100dp"
                            android:padding="@dimen/spacing_md"
                            android:text="@string/transfer_log"
                            android:textColor="@color/wayer_text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="monospace" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="@string/layout_fragment_home_text_18"
                        android:textColor="@color/wayer_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recent_transfers_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="@string/recent_transfers_empty_2"
                        android:textColor="@color/wayer_text_secondary"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recent_transfers_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>

        </ViewFlipper>
    </LinearLayout>

    <!-- Right sidebar: specialised + general (theme / blur) -->
    <LinearLayout
        android:id="@+id/transfer_sidebar_root"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_sidebar"
        android:padding="@dimen/spacing_md"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_fragment_transfer_text_35"
            android:textColor="@color/wayer_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/layout_fragment_transfer_text_36"
            android:textColor="@color/wayer_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/layout_fragment_transfer_text_37"
            android:textColor="@color/wayer_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/drawer_save_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/browse_current_path"
            android:textColor="@color/wayer_text_primary"
            android:textSize="12sp"
            android:maxLines="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_change_save"
            style="@style/Widget.Wayer.GlassButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/btn_change_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh_indexer"
            style="@style/Widget.Wayer.GlassButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/btn_refresh_indexer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/layout_fragment_transfer_text_38"
            android:textColor="@color/wayer_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/theme_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/theme_label"
            android:textColor="@color/wayer_text_primary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_theme"
            style="@style/Widget.Wayer.GlassButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/btn_theme" />

        <TextView
            android:id="@+id/blur_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/blur_label"
            android:textColor="@color/wayer_text_primary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_blur"
            style="@style/Widget.Wayer.GlassButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/btn_blur" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/layout_fragment_transfer_text_39"
            android:textColor="@color/wayer_text_disabled"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
