<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main.xml — updated Oct 2025 for standard Material 3 navigation.

  What changed (see docs/FRONTEND_IMPROVEMENTS.md):
    * Replaced the custom HorizontalScrollView + MaterialButtonToggleGroup (which
      existed because BottomNavigationView crashed at 5 items) with the current
      Material3 NavigationBarView (supports 6 destinations natively, with proper
      active indicator, ripple, and accessibility).
    * Removed 120dp fixed-width buttons and scroll container — NavigationBarView
      lays out 6 items evenly, with correct touch targets (48dp+), labels, and
      badge support. No scroll needed.
    * Background is wayer_surface_solid with 8dp elevation (not translucent).
    * fragment_container is still a FrameLayout — fragments handle their own
      scrolling; MainActivity only swaps them.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wayer_background">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Standard Material3 bottom bar — 6 items, no custom scroll hack -->
    <com.google.android.material.navigation.NavigationBarView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/wayer_surface_solid"
        app:elevation="8dp"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/wayer_primary"
        app:itemTextColor="@color/wayer_text_secondary"
        app:menu="@menu/menu_bottom_nav" />

</LinearLayout>
