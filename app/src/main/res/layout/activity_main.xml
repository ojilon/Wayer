<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/wayer_background">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Scrollable destination bar. BottomNavigationView hard-crashes past
         5 items, so this is a single-selection toggle group instead:
         120dp per destination, left-aligned so position 0 is always reachable
         (centering inside a scroller pushes the first items into negative,
         unreachable coordinates). -->
    <HorizontalScrollView
        android:id="@+id/bottom_nav_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="true"
        android:background="@color/wayer_surface">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/bottom_navigation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_home"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Home"
                app:icon="@drawable/ic_nav_home"
                app:iconGravity="textTop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_files"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Files"
                app:icon="@drawable/ic_nav_files"
                app:iconGravity="textTop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_storage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Storage"
                app:icon="@drawable/ic_nav_storage"
                app:iconGravity="textTop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_transfer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Transfer"
                app:icon="@drawable/ic_nav_transfer"
                app:iconGravity="textTop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_cleaner"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Cleaner"
                app:icon="@drawable/ic_nav_cleaner"
                app:iconGravity="textTop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nav_internals"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Internals"
                app:icon="@drawable/ic_nav_debug"
                app:iconGravity="textTop" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </HorizontalScrollView>

</LinearLayout>